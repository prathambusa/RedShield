# Copy to .env and fill in real values. Never commit .env.

# Required — Anthropic API key for both the upstream chatbot and the LLM classifier.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# Optional — override default models.
REDSHIELD_CHAT_MODEL=claude-haiku-4-5-20251001
REDSHIELD_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Optional — risk aggregator thresholds (0.0–1.0).
REDSHIELD_BLOCK_THRESHOLD=0.7
REDSHIELD_REVIEW_THRESHOLD=0.4

# Optional — audit log location.
REDSHIELD_AUDIT_DB=logs/audit.sqlite3

# Optional — admin stats endpoint token (dev only).
REDSHIELD_ADMIN_TOKEN=
